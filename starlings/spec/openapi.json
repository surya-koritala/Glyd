  "components": {
    "securitySchemes": {
      "clientToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random scoped token; TLS required for non-loopback clients."
      },
      "peerMTLS": {
        "type": "mutualTLS",
        "description": "Verify cluster certificate identity, role, membership, epoch and lease beyond TLS."
      }
    },
    "schemas": {
      "Error": {
        "$ref": "./control.schema.json#/$defs/Error"
      },
      "NodeCapabilities": {
        "$ref": "./control.schema.json#/$defs/NodeCapabilities"
      },
      "PlacementPlan": {
        "$ref": "./control.schema.json#/$defs/PlacementPlan"
      },
      "Lease": {
        "$ref": "./control.schema.json#/$defs/Lease"
      },
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string",
                  "maxLength": 1048576
                }
              },
              "required": [
                "role",
                "content"
              ]
            },
            "minItems": 1,
            "maxItems": 256
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "default": 1
