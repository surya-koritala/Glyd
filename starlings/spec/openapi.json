    "/v1/chat/completions": {
      "post": {
        "operationId": "chatCompletion",
        "x-required-role": "client:infer",
        "security": [
          {
            "clientToken": []
          }
        ],
        "servers": [
          {
            "url": "http://127.0.0.1:9740"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response or SSE stream. Each data record is StreamChunk JSON. Final data record is [DONE]. Post-header errors use event: error with Error JSON, then close; never send a successful finish marker after failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "X-Compute-Session-Id": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "description": "Session ID for explicit cancellation."
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or unsupported request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role, model or membership denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Epoch, profile or resource conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Quota or rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Capacity unavailable or backend unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "description": "One text completion per request. No tools, media, logprobs or n>1. Unknown fields fail. On stream disconnect, cancel unless an explicit future retain-session mode is negotiated. Idle and total deadlines apply. This is a documented subset, not full OpenAI API compatibility."
      }
    },
