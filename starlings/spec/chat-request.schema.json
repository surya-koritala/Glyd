{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:starlings:chat-request:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 1048576
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "default": 1
    },
    "top_p": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "stream": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "model",
    "messages",
    "max_tokens"
  ]
}
