{
  "architectures": [
    "Glm5NextForConditionalGeneration"
  ],
  "model_type": "glm5_next",
  "tie_word_embeddings": false,
  "quantization_config": {
    "activation_scheme": "dynamic",
    "fmt": "e4m3",
    "quant_method": "fp8",
    "weight_block_size": [
      128,
      128
    ]
  },
  "vision_config": {
    "model_type": "glm5_next_vision",
    "depth": 1,
    "hidden_size": 64
  },
  "text_config": {
    "model_type": "glm5_next_text",
    "attention_bias": false,
    "eos_token_id": [
      3,
      4
    ],
    "first_k_dense_replace": 1,
    "hc_eps": 1e-06,
    "hc_mult": 4,
    "hc_sinkhorn_iters": 20,
    "hidden_act": "silu",
    "hidden_size": 256,
    "index_head_dim": 32,
    "index_kpool": 4,
    "index_kpool_always_select_tail": true,
    "index_n_heads": 2,
    "index_topk": 8,
    "indexer_types": ["full", "full", "full", "full", "full"],
    "intermediate_size": 320,
    "kv_lora_rank": 64,
    "layer_types": ["linear_attention", "linear_attention", "deepseek_sparse_attention", "linear_attention", "deepseek_sparse_attention"],
    "linear_attn_config": {
      "num_heads": 2,
      "gate_lower_bound": -5.0,
      "head_dim": 64,
      "short_conv_kernel_size": 4,
      "kda_layers": [0, 1, 3],
      "full_attn_layers": [2, 4]
    },
    "max_position_embeddings": 4096,
    "mhc": true,
    "mla_use_nope": true,
    "mlp_layer_types": ["dense", "sparse", "sparse", "sparse", "sparse"],
    "moe_intermediate_size": 192,
    "moe_router_dtype": "float32",
    "n_group": 1,
    "n_routed_experts": 4,
    "n_shared_experts": 1,
    "norm_topk_prob": true,
    "num_attention_heads": 2,
    "num_experts_per_tok": 2,
    "num_hidden_layers": 5,
    "num_key_value_heads": 2,
    "num_nextn_predict_layers": 1,
    "q_lora_rank": 64,
    "qk_nope_head_dim": 64,
    "qk_rope_head_dim": 0,
    "rms_norm_eps": 1e-05,
    "routed_scaling_factor": 2.5,
    "scoring_func": "sigmoid",
    "swiglu_limit": 10.0,
    "topk_group": 1,
    "topk_method": "noaux_tc",
    "v_head_dim": 64,
    "vocab_size": 192
  }
